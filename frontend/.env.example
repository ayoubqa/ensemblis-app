# Where the Ensemblis backend API is reachable from the browser.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public origin for canonical URLs, sitemap.xml, robots.txt and Open Graph (optional;
# on Vercel the production domain is used when unset). No trailing slash.
NEXT_PUBLIC_SITE_URL=""

# Contact address shown on /privacy and /terms (required for a public deployment —
# the legal pages show a loud placeholder until this is set).
NEXT_PUBLIC_CONTACT_EMAIL=""
