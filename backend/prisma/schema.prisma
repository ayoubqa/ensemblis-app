// Ensemblis data model.
// This replaces the prototype's in-memory `S` object with real, persisted tables.
//
// v2 notes: every column added on top of the original `init` schema is either
// nullable or has a default, so `npx prisma migrate dev --name v2` applies
// cleanly to a database that already has rows in it.

generator client {
  provider      = "prisma-client-js"
  // "native" = whatever machine runs `prisma generate`; the second is Render's
  // Node runtime (Debian, OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// DATABASE_URL: on Neon use the *direct* (non-pooled) connection string with
// `?sslmode=require` — it works for both the app and `prisma db push`.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  COMPANY
  DEVELOPER
}

enum TaskStatus {
  PLANNING
  RUNNING
  COMPLETED
  FAILED
  REFUNDED
}

enum StepStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TransactionType {
  TASK_CHARGE
  REFUND
  TOP_UP
  PURCHASE // real money via Stripe Checkout (v3)
}

enum TeamRole {
  OWNER
  MEMBER
}

enum RevisionStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  company      String      @default("")
  role         String      @default("")
  accountType  AccountType @default(COMPANY)
  builds       String      @default("") // developer persona: what they build, optional
  credits      Int         @default(10000) // stored in cents to avoid float issues; signup sets STARTING_CREDITS_CENTS
  termsAcceptedAt DateTime? // when the user ticked "I agree to the Terms and Privacy Policy" (null for pre-existing accounts)
  createdAt    DateTime    @default(now())

  // v3
  isGuest         Boolean  @default(false) // "try without signing up" account; can be claimed later
  signupIpHash    String? // salted hash of the sign-up IP (guest trial limits); never the raw IP
  emailOnTaskDone Boolean  @default(true)

  tasks        Task[]
  agents       Agent[] // agents this user has published (developer persona)
  workflows    Workflow[]
  seats        TeamSeat[]
  transactions Transaction[] @relation("TransactionWallet") // ledger of this user's wallet
  actedTransactions Transaction[] @relation("TransactionActor") // charges this user triggered (may hit a team wallet)
  workforce    WorkforceMember[]
  ownedTeam      Team?          @relation("TeamOwner")
  teamMembership TeamMember?
  attachments    TaskAttachment[]
  passwordResets PasswordReset[]
  stripePayments StripePayment[]

  @@index([isGuest, createdAt])
  @@index([signupIpHash, createdAt])
}

model TeamSeat {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String
  role      String
  createdAt DateTime @default(now())
}

// Agents available in the marketplace. Seeded with the catalog in
// src/catalog/agents.ts; developers can publish more.
model Agent {
  id                String   @id @default(cuid())
  // Nullable in the DB only so the migration applies to pre-v2 rows; the seed
  // and the publish endpoint always set it, and the API falls back to a
  // slugified name if it is ever missing.
  slug              String?  @unique
  name              String   @unique
  category          String
  creator           String   @default("")
  description       String
  capabilities      String[] @default([])
  specialty         String   @default("")
  taskType          String   @default("")
  outputType        String   @default("Report")
  systemPrompt      String   @db.Text // the real instructions sent to the model for this agent
  pricePerTaskCents Int      @default(1500)
  priceFromCents    Int      @default(1000)
  estMinutesLow     Int      @default(5)
  estMinutesHigh    Int      @default(10)
  avgRunSeconds     Int      @default(450)
  successRate       Float    @default(95)
  rating            Float    @default(0)
  reputation        Int      @default(50)
  tasksCompleted    Int      @default(0)
  verified          Boolean  @default(false)
  hue               Int      @default(200)
  isLive            Boolean  @default(true)
  owner             User?    @relation(fields: [ownerId], references: [id])
  ownerId           String?
  createdAt         DateTime @default(now())

  tasks     Task[]
  steps     TaskStep[]
  workflows Workflow[]
  workforce WorkforceMember[]
}

model Task {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  agent        Agent?     @relation(fields: [agentId], references: [id]) // lead agent
  agentId      String?
  title        String
  description  String     @db.Text
  category     String?
  depth        String     @default("standard") // focused | standard | deep
  status       TaskStatus @default(PLANNING)
  costCents    Int        @default(0)
  result       String?    @db.Text // the final deliverable (markdown)
  errorMessage String?
  outcome      String? // 'Achieved' | 'Partially' | 'Not achieved', set by user feedback
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  // v3
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId       String? // set when created by a team member: visible to the whole team
  walletUserId String? // whose credits paid for this run (team owner for team tasks); refunds go back here
  isTest       Boolean    @default(false) // developer test run: free, excluded from revenue/stats
  // Not @unique on purpose: adding a unique constraint to an existing table makes `prisma db push`
  // demand --accept-data-loss and would stop the Render boot. Tokens are 24 random bytes (collision-free in practice).
  shareToken   String? // public read-only link /r/<token>; null = not shared
  sharedAt     DateTime?

  steps        TaskStep[]
  transactions Transaction[]
  sources      TaskSource[]
  attachments  TaskAttachment[]
  revisions    TaskRevision[]
  usageEvents  UsageEvent[]
  galleryItems GalleryItem[]

  @@index([userId, createdAt])
  @@index([agentId, status])
  @@index([teamId, createdAt])
  @@index([shareToken])
}

// One agent's contribution to a task run, executed sequentially.
model TaskStep {
  id          String     @id @default(cuid())
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  order       Int
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId     String?
  agentName   String
  role        String // Research | Analysis | Verification | Report
  title       String
  status      StepStatus @default(QUEUED)
  output      String?    @db.Text
  startedAt   DateTime?
  completedAt DateTime?

  @@index([taskId, order])
}

model Workflow {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  name        String
  basedOnText String    @db.Text
  frequency   String    @default("Monthly") // Weekly | Monthly | Quarterly
  depth       String    @default("standard")
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId     String?
  isActive    Boolean   @default(true)
  runCount    Int       @default(0)
  nextRun     DateTime?
  lastRun     DateTime?
  createdAt   DateTime  @default(now())

  @@index([isActive, nextRun])
}

// Credit ledger. amountCents is signed: negative for charges, positive for
// refunds and top-ups.
model Transaction {
  id          String          @id @default(cuid())
  user        User            @relation("TransactionWallet", fields: [userId], references: [id])
  userId      String // the WALLET whose balance changed (a team task charges the team owner's wallet)
  actor       User?           @relation("TransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId String? // who triggered it (null on pre-v3 rows = same as userId)
  type        TransactionType
  amountCents Int
  description String
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId      String?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
}

// A user's saved agents ("my workforce").
model WorkforceMember {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  createdAt DateTime @default(now())

  @@unique([userId, agentId])
}

// ============================================================ v3 models

// A team shares ONE wallet: the owner's User.credits. Members' own balances
// are untouched (and unused) while they're in the team.
model Team {
  id        String   @id @default(cuid())
  name      String
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String   @unique // a user owns at most one team
  createdAt DateTime @default(now())

  members TeamMember[]
  invites TeamInvite[]
  tasks   Task[]
}

model TeamMember {
  id       String   @id @default(cuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String   @unique // a user belongs to at most one team (the owner has a row too, role OWNER)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@index([teamId])
}

model TeamInvite {
  id          String    @id @default(cuid())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  token       String    @unique // random, URL-safe; the invite link is /join/<token>
  createdById String
  maxUses     Int       @default(10)
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([teamId])
}

// Numbered sources a task's agents may cite as [n]. Created before the team
// runs (web search / Wikipedia / client links / uploaded files).
model TaskSource {
  id          String   @id @default(cuid())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  n           Int // citation number, 1-based, unique per task
  kind        String // web | wikipedia | link | upload
  title       String
  url         String?
  domain      String?
  snippet     String   @db.Text
  publishedAt String?
  createdAt   DateTime @default(now())

  @@unique([taskId, n])
}

// Client-provided material. Files are converted to text in the browser; only
// the extracted text is stored (never the raw file). Links are fetched server-side.
model TaskAttachment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    String? // null until attached to a task on creation
  kind      String // pdf | csv | xlsx | docx | txt | md | url
  name      String
  url       String?
  charCount Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

// Follow-up refinements of a completed report. Version 1 is the original
// result (snapshotted when the first follow-up is requested).
model TaskRevision {
  id            String         @id @default(cuid())
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  version       Int
  instruction   String         @db.Text
  status        RevisionStatus @default(RUNNING)
  result        String?        @db.Text
  costCents     Int            @default(0)
  errorMessage  String?
  requestedById String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?

  @@unique([taskId, version])
}

model PasswordReset {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // sha256 of the emailed token; the token itself is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// One Stripe Checkout session; the webhook credits the wallet exactly once.
model StripePayment {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String // wallet credited
  packId      String
  amountCents Int // money charged (EUR cents)
  credits     Int // credits granted (cents)
  status      String    @default("pending") // pending | completed | expired
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Metering for the owner dashboard and budget guards.
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String // llm | search | email | fetch
  provider  String
  model     String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  ok        Boolean  @default(true)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Public example/featured reports shown in the gallery.
model GalleryItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String   @db.Text
  content     String   @db.Text // markdown (snapshot; independent of the source task)
  sources     Json     @default("[]") // TaskSource-shaped array
  agentName   String
  depth       String   @default("standard")
  isExample   Boolean  @default(true) // true = curated example written for the demo, false = featured real report
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId      String?
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
