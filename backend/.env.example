# =====================================================================
# Ensemblis backend settings. Copy to `.env` for local development.
# In production (Render), set these in the dashboard instead — render.yaml
# at the repo root already sets sensible production values.
# =====================================================================

# ---- Database ----
# Postgres connection string.
# Local dev (matches docker-compose.yml at the repo root):
DATABASE_URL="postgresql://ensemblis:ensemblis@localhost:5432/ensemblis?schema=public"
# On Neon (production) use the *direct* (non-pooled) connection string, ending in ?sslmode=require.
# If DATABASE_URL is Neon's pooled ("-pooler") string, also set DIRECT_URL to the direct one; the boot-time
# migration step (src/ops/migrate.ts) uses it, because Prisma's migration lock needs a real session.
# DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Server ----
# Any long random string (16+ chars) — used to sign auth session tokens.
# In production the server refuses to start if this is missing or a placeholder.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on (Render sets this for you).
PORT=4000

# Comma-separated list of exact origins allowed to call this API (your frontend
# URL, e.g. "https://ensemblis.vercel.app"). Trailing slashes are ignored.
CORS_ORIGIN="http://localhost:3000"

# Number of reverse proxies in front of the app. Default: 1.
# TRUST_PROXY=1

# Header(s) that carry the real visitor IP, set by your host's edge (used for
# per-IP rate limits, the guest-trial limit and the bot check). On Render this
# defaults to "cf-connecting-ip,true-client-ip" automatically (Render sits
# behind Cloudflare and has several proxies, so the plain request IP is a
# proxy shared by every visitor). Elsewhere the default is none (= use the
# request IP + TRUST_PROXY). Only list headers your host overwrites — a header
# the visitor can set themselves would let them fake their IP. "none" = off.
# CLIENT_IP_HEADER=""

# Public-demo mode: the frontend shows a demo banner and AI disclaimers.
# Default: false (render.yaml sets true).
# DEMO_MODE="false"

# ---- AI provider ----
# "ollama" (default): a free local model via Ollama. No account, no payment.
#   Install Ollama (https://ollama.com), run `ollama pull llama3.2` once, and
#   make sure `ollama serve` is running (the desktop app does this for you).
# "openai": any OpenAI-compatible Chat Completions API. Defaults target Groq's
#   free plan (https://console.groq.com/keys). Use this when hosting publicly —
#   a hosted server can't reach the Ollama on your laptop.
# "anthropic": the real Claude API. Costs money — see README.
# "mock": deterministic scripted output for development and automated tests
#   only (no model needed). Refused when NODE_ENV=production, and labelled
#   "Mock AI — test output" in the UI.
AI_PROVIDER="ollama"
# Mock provider only: spread each step's output over this many ms so live
# progress is visible in dev / E2E. Default: 0.
# MOCK_AI_DELAY_MS=1500

# Only used when AI_PROVIDER="ollama". Defaults shown.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"
# Context window requested from Ollama, in tokens. Our prompts (objective,
# company context, evidence, prior work) need more than Ollama's 2–4k default,
# which silently truncates them. Default: 16384 (more RAM; lower if needed).
# OLLAMA_NUM_CTX=16384

# Only used when AI_PROVIDER="openai".
# OPENAI_API_KEY="gsk_..."                              # required
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"      # default (Groq)
# OPENAI_MODEL="openai/gpt-oss-120b"                    # default (Groq retired llama-3.3-70b-versatile in Aug 2026)
# OPENAI_MAX_TOKENS=8192                                # max output tokens per step (reasoning models use part of it to think)
# OPENAI_REASONING_EFFORT="low"                         # low|medium|high — only for reasoning models such as gpt-oss

# Only used when AI_PROVIDER="anthropic". Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-..."
# CLAUDE_MODEL="claude-haiku-4-5-20251001"

# Optional: override the provider name shown in the UI (default is derived,
# e.g. "Groq (Llama 3.3 70B)", "Claude", "Local model (Ollama)").
# AI_PROVIDER_LABEL=""

# Max model calls in flight at once across the whole server (all providers).
# Extra calls wait in a queue instead of tripping free-tier rate limits. Default: 2.
# MAX_CONCURRENT_LLM=2

# Timeout for one model call (incl. retries on 429/503), in ms.
# Default: 120000 (2 min); 600000 for ollama, since laptop CPUs are slow.
# LLM_TIMEOUT_MS=120000

# ---- Sign-up & balance ----
# If set, sign-up requires this invite code (wrong code -> 403). Empty = open sign-up.
# SIGNUP_INVITE_CODE=""

# Credits a new account starts with (10000 = 10,000 credits). Default: 10000.
# STARTING_CREDITS_CENTS=10000

# Allow the "add demo credits" button. Default: true.
# DEMO_TOPUP_ENABLED="true"
# Lifetime cap on demo top-ups per account, in credits (0 = none). Default: 5000.
# DEMO_TOPUP_MAX_CENTS=5000

# ---- Credits & cost accounting ----
# Balances, budgets and prices are whole Ensemblis credits (the *_CENTS settings
# above are credits too). Internal value of a credit for accounting/pricing:
# 100 = 1 credit is worth €0.01 (the rate existing balances were issued at).
# CREDITS_PER_EUR=100
# Runaway guard: an execution stops (and is refunded) after this many model tokens. 0 = off.
# MAX_TOKENS_PER_EXECUTION=600000
# Monetary guard (inactive while PROVIDER_PRICING is unset): provider cost may use at most this share of a run's price,
# or this many euros. A pre-call check between steps, not a hard cap (DEPLOYMENT.md, "The monetary guard").
# MAX_COST_SHARE_OF_PRICE=0.3
# MAX_COST_PER_EXECUTION_EUR=0
# COST_ESTIMATE_INPUT_TOKENS=16000
# When something in use has no price (a model, search:tavily, an fx rate): stop (default) stops and refunds the run;
# allow checks only the priced part.
# COST_GUARD_UNPRICED=stop
# Internal price table (JSON) for cost and margin on the owner dashboard. Unset = unpriced, never guessed.
# Price both model tiers, search:tavily when live search is on, and an fx rate for each currency.
# PROVIDER_PRICING={"models":{"openai/gpt-oss-120b":{"inputPerMTok":0,"outputPerMTok":0,"currency":"USD"}},"tools":{"search:tavily":{"perCall":0,"currency":"USD"}},"fx":{"USD":1}}

# ---- Cost protection (the "kill switch" on your AI bill) ----
# Every execution start (approval, auto-run, run again, recurring run) counts
# once. Limits reset at midnight UTC. (Names kept from v3 for compatibility.)
# MAX_TASKS_PER_USER_PER_DAY=10
# MAX_TASKS_PER_DAY_GLOBAL=300

# Planning is not charged (only an approved execution is), so it has its own caps.
# Defaults: 4x the execution caps above, at least 10 per organization / 50 server-wide;
# 3 a day for a guest trial; at most 3 objectives planning at once per organization.
# MAX_PLANS_PER_ORG_PER_DAY=40
# MAX_PLANS_PER_GUEST_PER_DAY=3
# MAX_PLANS_PER_DAY_GLOBAL=1200
# MAX_CONCURRENT_PLANNING_PER_ORG=3

# Max characters in an objective statement. Default: 4000.
# MAX_DESCRIPTION_LENGTH=4000

# ---- Per-IP rate limits (defaults shown) ----
# RATE_LIMIT_GLOBAL_PER_15MIN=600     # all /api requests
# RATE_LIMIT_SIGNUP_PER_HOUR=5
# RATE_LIMIT_LOGIN_PER_15MIN=20
# RATE_LIMIT_ESTIMATE_PER_MIN=40
# RATE_LIMIT_TASK_RUNS_PER_MIN=10     # execution starts per minute

# ---- Execution engine (v4) ----
# Executions run from a durable Postgres job queue. The worker can run inside
# the API process (EMBEDDED_WORKER, default: on outside production, off in
# production) or as its own process: `npm run start:worker`. render.yaml runs it
# inside the API (EMBEDDED_WORKER="true"). Run at least one of the two.
# EMBEDDED_WORKER="true"
# Jobs one worker process runs at once. Default: 2.
# WORKER_CONCURRENCY=2
# How often an idle worker polls for jobs, in ms. Default: 1000.
# WORKER_POLL_MS=1000
# Job lease; a crashed worker's job is re-claimed after this. Default: 120000.
# WORKER_LEASE_MS=120000
# Back-off between automatic retries of a failed step (comma-separated ms).
# Default: 5000,20000,60000 (three attempts, then an exception for a person).
# STEP_RETRY_DELAYS_MS="5000,20000,60000"
# An execution with no progress for this long is failed and refunded. Default: 45 min.
# EXECUTION_STALL_MS=2700000
# An execution waiting on a person (approval/exception) this long expires. Default: 14 days.
# EXECUTION_WAIT_EXPIRY_MS=1209600000
# Recurring objectives are started by the worker's maintenance loop.
# DISABLE_SCHEDULER="true"
# When the AI verifier can't run (rejected key, exhausted quota, timeout,
# unusable reply), the result is NOT verified (UNVERIFIED — never shown as
# passed): it is checked again once after this pause, then handed to a person
# as "The result could not be verified" (accept / retry / cancel). Accepting
# keeps it UNVERIFIED, the outcome UNKNOWN, and refunds the verification fee.
# Set it on the API and the worker alike. Default: 60000 (1 min).
# VERIFY_RETRY_DELAY_MS=60000
#
# Model-layer errors: HTTP 500 and connection errors from the AI provider are
# retried like 502/503/504. An exhausted quota (OpenAI insufficient_quota or a
# long Retry-After, Anthropic credit errors) is NOT retried; a missing or
# rejected key blocks planning (PROVIDER_UNAVAILABLE) before anything is charged.

# ---- Logging ----
# JSON lines in production (or with LOG_FORMAT="json"); readable
# "event key=value" lines in development. LOG_LEVEL: debug|info|warn|error.
# LOG_FORMAT="json"
# LOG_LEVEL="info"

# =====================================================================
# v3 optional services — every one is OFF (or uses a free default) when its
# variables are missing, so you can add them one at a time.
# =====================================================================

# Public URL of the FRONTEND (no trailing slash). Used in emails, share links
# and Stripe redirects. Default: the first CORS_ORIGIN.
# APP_URL="https://ensemblis.vercel.app"

# Comma-separated emails that may open the operations console (/admin).
# Case-insensitive. The address must ALSO be verified (email link, or
# `npm run ops:verify-email -- you@example.com` against this database) —
# merely signing up with a listed address grants nothing.
# ADMIN_EMAILS="you@example.com"

# ---- Web research (research capabilities cite numbered sources) ----
# Default: Tavily when TAVILY_API_KEY is set, otherwise keyless Wikipedia.
# Free Tavily key (1,000 searches/month): https://app.tavily.com
#
# Research briefs (Define → Deliverable: "Research brief (evidence-backed)")
# need web search:
#   - Tavily (TAVILY_API_KEY) is what a brief is meant to run on.
#   - Wikipedia only (no key, or SEARCH_PROVIDER=wikipedia): the brief runs, and
#     the define page labels it "limited evidence".
#   - SEARCH_PROVIDER=off: the define page disables launching a brief, and a
#     brief started through the API is blocked at planning (PROVIDER_UNAVAILABLE)
#     before anything is charged.
# A brief that ends with no external source fails verification ("Insufficient
# evidence") — it is never labelled verified on company context alone.
# TAVILY_API_KEY="tvly-..."
# Force a provider: tavily | wikipedia | off
# SEARCH_PROVIDER=""
# Max SUCCESSFUL Tavily calls per UTC day across the server (failed calls don't
# count). A research step makes 3 searches and other web steps 2 each (plus 2
# when a brief's automatic revision researches again), so a brief typically
# uses 3–9 and the default 30 allows only a few briefs a day — raise it
# (e.g. 200) for demos and the live smoke. When it is spent, searches fall back
# to Wikipedia and the research is recorded as "degraded". Default: 30.
# SEARCH_DAILY_BUDGET=30
# Testing only: point Tavily / Resend at a local stub server. Leave unset in production.
# TAVILY_BASE_URL="https://api.tavily.com"
# RESEND_BASE_URL="https://api.resend.com"

# Optional smaller/faster model for quick helper calls (e.g. clarifying
# questions) when AI_PROVIDER="openai". Default: openai/gpt-oss-20b on Groq,
# otherwise OPENAI_MODEL.
# OPENAI_FAST_MODEL="openai/gpt-oss-20b"

# ---- Email via Resend (objective notifications, email verification, password reset) ----
# Off unless BOTH are set. https://resend.com — verify your sending domain first.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Ensemblis <hello@yourdomain.com>"

# ---- Real payments via Stripe Checkout (balance top-ups) ----
# Off unless BOTH are set. Start with TEST keys (sk_test_...).
# Webhook endpoint: https://<your-api>/api/billing/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Monthly plans (Stripe Billing; DEPLOYMENT.md §2b) ----
# Off unless SUBSCRIPTIONS_ENABLED=true, Stripe is configured above, and the plan has a Price ID.
# Each Price must be a recurring monthly EUR price of exactly the plan's amount (checkout checks this).
# Add the subscription events listed in DEPLOYMENT.md §2b to the same webhook endpoint.
# SUBSCRIPTIONS_ENABLED="false"
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_GROWTH="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PORTAL_CONFIGURATION_ID="bpc_..."   # optional; default portal otherwise
# SUBSCRIPTION_PAST_DUE_ACCESS="keep"         # keep | revoke plan limits while a renewal payment is failing
# Proposed catalogue (change here, never in the frontend):
# PLAN_STARTER_PRICE_CENTS=2900   PLAN_STARTER_CREDITS=3000    PLAN_STARTER_RUNS_PER_DAY=5
# PLAN_GROWTH_PRICE_CENTS=9900    PLAN_GROWTH_CREDITS=15000    PLAN_GROWTH_RUNS_PER_DAY=15
# PLAN_BUSINESS_PRICE_CENTS=29900 PLAN_BUSINESS_CREDITS=60000  PLAN_BUSINESS_RUNS_PER_DAY=40
# RATE_LIMIT_CHECKOUT_PER_MIN=10

# ---- "Try without signing up" guest trial ----
# GUEST_TRIAL_ENABLED="true"
# GUEST_CREDITS_CENTS=5000          # trial balance; covers one typical execution (plans are capped at 7 steps)
# GUEST_MAX_TASKS=1                 # executions a guest may start
# GUEST_TRIALS_PER_IP_PER_DAY=2     # per network (salted IP hash — raw IPs are never stored)
# GUEST_TRIALS_PER_DAY=30           # across the whole server (0 = trial off)
# GUEST_RETENTION_DAYS=7            # unclaimed guest accounts are deleted after this
# Secret salt for hashing IPs. Default: JWT_SECRET. Set any long random string.
# IP_HASH_SALT=""

# ---- Cloudflare Turnstile bot check (guest trial + sign-up) ----
# Off unless BOTH are set. https://dash.cloudflare.com -> Turnstile.
# TURNSTILE_SITE_KEY="0x4AAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAA..."

# ---- Retired v3 settings ----
# FOLLOWUP_COST_CENTS, CLARIFY_ENABLED, MAX_ATTACHMENTS, MAX_ATTACHMENT_CHARS
# and DEV_TEST_RUNS_PER_DAY belonged to the task marketplace and are ignored.
# Company documents are limited to 25 per organization.
