# Postgres connection string.
# Local dev (matches docker-compose.yml at the repo root):
DATABASE_URL="postgresql://ensemblis:ensemblis@localhost:5432/ensemblis?schema=public"

# Any long random string — used to sign auth session tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGIN="http://localhost:3000"

# ---- AI provider ----
# "ollama" (default): a free local model via Ollama. No account, no payment.
#   Install Ollama (https://ollama.com), run `ollama pull llama3.2` once, and
#   make sure `ollama serve` is running (the desktop app does this for you).
# "anthropic": the real Claude API. Costs money — see README. Requires
#   ANTHROPIC_API_KEY below.
AI_PROVIDER="ollama"

# Only used when AI_PROVIDER="ollama". Defaults shown — usually no need to set these.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"

# Only used when AI_PROVIDER="anthropic". Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-..."
# CLAUDE_MODEL="claude-haiku-4-5-20251001"
